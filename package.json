{
  "name": "grupo-msa-challenge",
  "version": "1.0.0",
  "private": true,
  "description": "QA Manual con Automation challenge: Playwright + TypeScript framework for Tricentis Demo Web Shop.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "playwright test --grep-invert @forced-failure",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression --grep-invert @forced-failure",
    "test:api": "playwright test tests/api",
    "test:forced-failure": "playwright test --grep @forced-failure",
    "test:all": "playwright test",
    "report": "playwright show-report",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
